rules_version = '2';

// Saved signatures (js/account.js): users/{uid}/signatures/{id}, each
// { png: PNG data URL, w, h, createdAt }. A signed-in user can read, add and
// delete only their own; nothing else in the database is reachable. Saved
// signatures are never edited in place, so updates are refused outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/signatures/{sigId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['png', 'w', 'h', 'createdAt'])
        && request.resource.data.png is string
        && request.resource.data.png.size() < 1000000
        && request.resource.data.png.matches('data:image/png;base64,.*')
        && request.resource.data.w is number && request.resource.data.w > 0
        && request.resource.data.h is number && request.resource.data.h > 0
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
